rules_version = '2';

/* Regles Firestore de BeniGo.
   A publier dans la console Firebase : Firestore Database > Regles.
   Elles portent les regles metier de la commande : seul l acheteur commande,
   seul le vendeur remet le colis, seul l acheteur confirme la reception, et
   les tiers ne voient rien. Aucun paiement ne transite par la plateforme. */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /* Plafond de securite de l essai vendeur, en millisecondes (366 jours).
       La duree reelle de l essai se regle dans js/store.js
       (SUBSCRIPTION_FREE_DAYS) : tant qu elle reste sous ce plafond, ces
       regles n ont pas besoin d etre modifiees. Pour offrir davantage, il
       faut augmenter ce plafond ET SUBSCRIPTION_MAX_DAYS dans js/store.js. */
    function plafondEssaiMs() {
      return 31622400000;
    }

    /* Abonnement vendeur : la date de fin portee par le profil doit rester
       dans le futur. Un profil sans date (cree avant l abonnement) retombe
       sur le plafond a partir de sa date d inscription. */
    function abonnementActif(uid) {
      let profil = get(/databases/$(database)/documents/users/$(uid)).data;
      let fin = profil.get('abonnementJusquA', profil.get('createdAt', 0) + plafondEssaiMs());
      return fin >= request.time.toMillis();
    }

    /* Profils : le nom et le telephone sont visibles pour les membres connectes
       (ils servent a joindre l autre partie pendant une livraison). */
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        /* L inscription ecrit la date de fin, plafonnee : aucun compte ne
           peut s offrir un abonnement au dela du plafond. */
        && request.resource.data.abonnementJusquA is int
        && request.resource.data.abonnementJusquA
          <= request.time.toMillis() + plafondEssaiMs();
      /* Le membre modifie son profil mais pas sa date d abonnement : seul le
         proprietaire du projet peut la prolonger, depuis la console. */
      allow update: if isSelf(uid)
        && request.resource.data.get('abonnementJusquA', 0)
          == resource.data.get('abonnementJusquA', 0);
      allow delete: if isSelf(uid);
    }

    match /listings/{listingId} {
      allow read: if true;

      /* Publier demande un abonnement vendeur actif. Les annonces deja en
         ligne restent lisibles, modifiables et retirables apres expiration. */
      allow create: if signedIn()
        && abonnementActif(request.auth.uid)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.price is int
        && request.resource.data.price >= 100
        && request.resource.data.status == 'active'
        && request.resource.data.images is list
        && request.resource.data.images.size() > 0
        && request.resource.data.images.size() <= 4;

      /* Le vendeur modifie ou retire son annonce. */
      allow update, delete: if isSelf(resource.data.sellerId);

      /* Un acheteur peut seulement reserver une annonce encore active, en
         changeant son statut : la reservation accompagne la commande. */
      allow update: if signedIn()
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'reservee';

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 2
          && request.resource.data.text.size() <= 400;
        allow update, delete: if false;
      }
    }

    /* Commandes : visibles par l acheteur et le vendeur seulement. */
    match /orders/{ref} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      /* L acheteur cree la commande. Aucune donnee de paiement n y figure :
         le reglement se fait a la remise, hors de la plateforme. */
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.buyerId != request.resource.data.sellerId
        && request.resource.data.members == [request.resource.data.buyerId, request.resource.data.sellerId]
        && request.resource.data.status == 'commande'
        && request.resource.data.price is int
        && request.resource.data.price >= 100
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6;

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedAt'])
        && (
          (request.auth.uid == resource.data.sellerId
            && resource.data.status == 'commande'
            && request.resource.data.status == 'expediee')
          ||
          (request.auth.uid == resource.data.buyerId
            && resource.data.status in ['commande', 'expediee']
            && request.resource.data.status == 'terminee')
        );

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
